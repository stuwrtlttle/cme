{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmetaxonomy.org/schema/coverage-assessment.schema.json",
  "title": "CME Coverage Assessment",
  "description": "Evidence-backed positive or negative assessment of CME coverage for a weakness, vulnerability, or capability.",
  "type": "object",
  "required": ["assessment_id", "target", "taxonomy_version", "method", "candidates_considered", "conclusion", "evidence"],
  "properties": {
    "assessment_id": { "type": "string", "pattern": "^CMA-[A-Z0-9-]+$" },
    "target": {
      "type": "object",
      "required": ["namespace", "id"],
      "properties": {
        "namespace": { "type": "string", "enum": ["CWE", "CVE", "CAPABILITY"] },
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "candidates_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cme_id", "decision", "rationale"],
        "properties": {
          "cme_id": { "type": "string", "pattern": "^CME-\\d{3,4}$" },
          "decision": { "type": "string", "enum": ["accepted", "rejected"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conclusion": { "type": "string", "enum": ["coverage_exists", "no_control_exists", "no_adequate_control_exists", "coverage_unknown"] },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reviewed_at": { "type": "string", "format": "date" }
  },
  "allOf": [
    {
      "if": { "properties": { "conclusion": { "enum": ["no_control_exists", "no_adequate_control_exists"] } } },
      "then": { "properties": { "candidates_considered": { "minItems": 1 } } }
    }
  ]
}
