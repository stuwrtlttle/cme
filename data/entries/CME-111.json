  "cme_id": "CME-111",
  "control_name": "Secure Boot (UEFI)",
  "description": "Firmware-level verification that only signed bootloaders and kernels execute, preventing boot-level rootkits and unauthorized kernel replacement.",
  "tactic": "Harden",
  "category": "Kernel Hardening",
