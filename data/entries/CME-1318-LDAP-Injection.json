{
  "cme_id": "CME-1318",
  "control_name": "LDAP Injection Prevention",
  "description": "Prevention of LDAP injection attacks through parameterized LDAP queries, input sanitization of special characters (*, (, ), \\, NUL, |, &), and use of LDAP filter escaping functions. Prevents attackers from manipulating LDAP search filters to bypass authentication, escalate privileges, or extract unauthorized directory data. Applies DN escaping for distinguished names and filter escaping for search filter values.",
  "tactic": "Harden",
  "category": "Application Input Validation",
  "category_id": "application-input-validation",
  "function_id": "injection-prevention",
  "effect_mode": "preventive",
  "evidence_state": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "AC",
      "from": "L",
      "to": "H",
      "rationale": "Requires crafted input AND LDAP filter bypass; escaping prevents filter manipulation"
    },
    {
      "metric": "I",
      "from": "H",
      "to": "L",
      "rationale": "Prevents unauthorized directory writes and authentication bypass via filter injection"
    },
    {
      "metric": "C",
      "from": "H",
      "to": "L",
      "rationale": "Prevents directory enumeration and unauthorized data extraction via wildcard injection"
    }
  ],
  "cwe_relationships": [
    "CWE-90",
    "CWE-943",
    "CWE-20"
  ],
  "verification": {
    "method": "Code review for LDAP filter escaping and parameterized queries",
    "commands": [
      {
        "command": "grep -r 'ldap_search' /path/to/app | grep -v -E '(ldap_escape|escapeLdapFilter|Filter.escape)'",
        "expected": "No matches (all queries use escaping)",
        "platform": "linux"
      },
      {
        "command": "grep -r 'DirectorySearcher' /path/to/app/*.cs | grep 'Filter\\s*=' | grep -v 'Encoder.LdapFilterEncode'",
        "expected": "No matches (all .NET LDAP queries use encoding)",
        "platform": "windows"
      },
      {
        "command": "semgrep --config 'r/generic.secrets.security.detected-ldap-injection' /path/to/app",
        "expected": "No findings",
        "platform": "any"
      }
    ]
  },
  "references": [
    {
      "source": "OWASP LDAP Injection",
      "url": "https://owasp.org/www-community/attacks/LDAP_Injection"
    },
    {
      "source": "CWE-90",
      "url": "https://cwe.mitre.org/data/definitions/90.html"
    }
  ],
  "platforms": [
    "Any (application-layer control)"
  ],
  "scf_identifiers": [
    "IAC-15",
    "IAC-15.1"
  ],
  "relationships": [
