{
  "cme_id": "CME-407",
  "control_name": "Data-at-Rest Encryption (LUKS/dm-crypt / BitLocker)",
  "description": "Encrypts data volumes and partitions at the block device layer using LUKS2/dm-crypt, ensuring that sensitive data including credentials, tokens, PII, and configuration secrets is encrypted when stored on disk. Prevents unauthorized data access through physical media theft, backup exposure, or filesystem-level read vulnerabilities. Combined with TPM-backed key sealing, provides boot-time integrity verification and automatic unlocking for authorized systems.",
  "tactic": "Harden",
  "category": "Cryptographic Controls",
  "category_id": "cryptographic-controls",
  "function_id": "data-integrity-crypto",
  "control_layer": "Data",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "C",
      "from": "H",
      "to": "L",
      "rationale": "Even if an attacker gains file read access through a path traversal or application vulnerability, the underlying block device encryption prevents reading the actual cleartext data without the encryption key."
    }
  ],
  "cwe_relationships": [
    "CWE-312",
    "CWE-311",
    "CWE-316"
  ],
  "confidence": "High",
  "platforms": [
    "RHEL 9",
    "Ubuntu 24.04",
    "Fedora 40",
    "Windows 10",
    "Windows 11",
    "Windows Server 2022"
  ],
  "verification": {
    "method": "Check for LUKS-encrypted volumes",
    "commands": [
      {
        "command": "lsblk -o NAME,TYPE,FSTYPE | grep crypt",
        "expected": "At least one crypt volume present",
        "platform": "linux"
      },
      {
        "command": "(Get-BitLockerVolume -MountPoint 'C:').ProtectionStatus",
        "expected": "On",
        "platform": "windows"
      },
      {
        "command": "(Get-BitLockerVolume -MountPoint 'C:').EncryptionMethod",
        "expected": "XtsAes256",
        "platform": "windows"
      }
    ]
  },
  "cve_schema_version": "5.2.0",
  "cve_affected": [
    {
      "vendor": "microsoft",
      "product": "windows",
      "cpes": [
        "cpe:2.3:o:microsoft:windows_10:*:*:*:*:*:*:*:*",
        "cpe:2.3:o:microsoft:windows_11:*:*:*:*:*:*:*:*",
        "cpe:2.3:o:microsoft:windows_server_2019:*:*:*:*:*:*:*",
        "cpe:2.3:o:microsoft:windows_server_2022:*:*:*:*:*:*:*"
      ],
      "defaultStatus": "applicable"
    }
  ],
  "remediation": [
    {
      "id": "luks-encrypt-partition",
      "name": "LUKS2 full-disk encryption via cryptsetup",
      "platform": "linux",
      "precondition": "command -v cryptsetup >/dev/null 2>&1 || command -v dnf >/dev/null 2>&1",
      "steps": [
        {
          "description": "Install cryptsetup if not already present",
          "command": "dnf install -y cryptsetup",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "dnf remove -y cryptsetup"
        },
        {
          "description": "DESTRUCTIVE: Format the target partition with LUKS2 encryption. ALL DATA ON THE PARTITION WILL BE DESTROYED. Back up the partition before running this command. Requires interactive passphrase entry.",
          "command": "cryptsetup luksFormat --type luks2 --cipher aes-xts-plain64 --key-size 512 --hash sha256 <device>",
          "idempotent": false,
          "requires_restart": "none",
          "reversible": false
        },
        {
          "description": "Open the LUKS volume and create a device-mapper mapping",
          "command": "cryptsetup luksOpen <device> <name>",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "cryptsetup luksClose <name>"
        },
        {
          "description": "Create an XFS filesystem on the opened LUKS volume",
          "command": "mkfs.xfs /dev/mapper/<name>",
          "idempotent": false,
          "requires_restart": "none",
          "reversible": false
        },
        {
          "description": "Add the LUKS volume to /etc/crypttab for automatic unlock at boot (passphrase prompt or key file)",
          "command": "echo '<name> <device> none discard' >> /etc/crypttab",
          "idempotent": false,
          "requires_restart": "system",
          "reversible": true,
          "undo": "sed -i '/^<name> /d' /etc/crypttab"
        }
      ],
      "verify": "lsblk -o NAME,TYPE,FSTYPE | grep crypt",
      "references": [
        {
          "source": "RHEL 9 Security Hardening — Encrypting block devices using LUKS",
          "url": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/security_hardening/encrypting-block-devices-using-luks_security-hardening"
        },
        {
          "source": "cryptsetup(8) man page",
          "url": "https://man7.org/linux/man-pages/man8/cryptsetup.8.html"
        }
      ]
    },
    {
      "id": "bitlocker-enable",
      "name": "BitLocker volume encryption with XTS-AES-256",
      "platform": "windows",
      "precondition": "Get-Command Enable-BitLocker -ErrorAction SilentlyContinue",
      "steps": [
        {
          "description": "Enable BitLocker on the system drive with XTS-AES-256 encryption and a recovery password protector. Used-space-only mode encrypts faster on new volumes; for existing data volumes use full encryption.",
          "command": "Enable-BitLocker -MountPoint 'C:' -EncryptionMethod XtsAes256 -UsedSpaceOnly -RecoveryPasswordProtector",
          "idempotent": true,
          "requires_restart": "system",
          "reversible": true,
          "undo": "Disable-BitLocker -MountPoint 'C:'"
        }
      ],
      "verify": "Get-BitLockerVolume -MountPoint 'C:' | Select-Object VolumeStatus,EncryptionMethod,ProtectionStatus",
      "references": [
        {
          "source": "Microsoft — BitLocker overview",
          "url": "https://learn.microsoft.com/en-us/windows/security/operating-system-security/data-protection/bitlocker/"
        },
        {
          "source": "Microsoft — Enable-BitLocker cmdlet",
          "url": "https://learn.microsoft.com/en-us/powershell/module/bitlocker/enable-bitlocker"
        }
      ]
    }
  ],
