{
  "cme_id": "CME-1102",
  "control_name": "Live Kernel Patching (kpatch/livepatch)",
  "description": "Applies critical kernel security fixes without system reboot, eliminating the patch-reboot delay that leaves systems vulnerable. Patches are applied to the running kernel in memory.",
  "tactic": "Evict",
  "category": "Patch Management",
  "category_id": "patch-management",
  "function_id": "automated-updates",
  "control_layer": "OS/Kernel",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "AC",
      "from": "L",
      "to": "H",
      "rationale": "Temporal: kernel vulnerability patched immediately without reboot window"
    }
  ],
  "cwe_relationships": [
    "CWE-119"
  ],
  "verification": {
    "method": "Check for active kernel live patches",
    "commands": [
      {
        "command": "kpatch list",
        "expected": "installed",
        "platform": "rhel"
      },
      {
        "command": "canonical-livepatch status",
        "expected": "running",
        "platform": "debian"
      }
    ]
  },
  "confidence": "High",
  "platforms": [
    "RHEL 9",
    "RHEL 8",
    "Ubuntu Pro"
  ],
  "remediation": [
    {
      "id": "kpatch-enable",
      "name": "RHEL kpatch live kernel patching",
      "platform": "rhel",
      "precondition": "command -v dnf >/dev/null 2>&1",
      "steps": [
        {
          "description": "Install kpatch client and dnf plugin for automatic live patch management",
          "command": "dnf install -y kpatch kpatch-dnf",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "dnf remove -y kpatch kpatch-dnf"
        },
        {
          "description": "Install the live patch module for the currently running kernel; requires an active RHEL subscription",
          "command": "dnf install -y kpatch-patch-$(uname -r | sed 's/\\.[^.]*$//')",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "dnf remove -y kpatch-patch-*"
        },
        {
          "description": "Enable the kpatch systemd service to automatically apply live patches at boot",
          "command": "systemctl enable kpatch",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "systemctl disable kpatch"
        }
      ],
      "verify": "kpatch list && rpm -qa | grep kpatch-patch",
      "references": [
        {
          "source": "RHEL 9 — Managing, monitoring, and updating the kernel — Applying kernel live patches",
          "url": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/managing_monitoring_and_updating_the_kernel/applying-patches-with-kernel-live-patching_managing-monitoring-and-updating-the-kernel"
        }
      ]
    }
  ],
