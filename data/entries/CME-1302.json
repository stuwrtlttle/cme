{
  "cme_id": "CME-1302",
  "control_name": "Deserialization Allowlist (Safe Loading)",
  "description": "Restricts deserialization to an explicit allowlist of permitted types, classes, or functions. Prevents attacker-controlled serialized data from instantiating arbitrary objects, invoking dangerous functions, or triggering unintended code paths. Applies to JSON schema validation, YAML safe_load, pickle restrictions, and custom deserialization frameworks.",
  "tactic": "Harden",
  "category": "Application Input Validation",
  "category_id": "application-input-validation",
  "function_id": "input-validation",
  "control_layer": "Application",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "AC",
      "from": "L",
      "to": "H",
      "rationale": "Only allowlisted types can be deserialized; attacker must find an exploitable gadget chain using only permitted types, which is fundamentally harder than exploiting unrestricted deserialization"
    },
    {
      "metric": "C",
      "from": "H",
      "to": "L",
      "rationale": "Arbitrary code execution via gadget chains blocked; attacker cannot exfiltrate data beyond what allowlisted types expose"
    },
    {
      "metric": "I",
      "from": "H",
      "to": "L",
      "rationale": "Cannot invoke arbitrary functions or modify state via deserialized objects; modifications limited to intended domain of allowlisted types"
    }
  ],
  "cwe_relationships": [
    "CWE-470",
    "CWE-502",
    "CWE-1188"
  ],
  "verification": {
    "method": "Verify deserialization uses safe loading or allowlist enforcement across all application languages",
    "commands": [
      {
        "command": "grep -rn 'yaml.safe_load\\|SafeLoader\\|RestrictedUnpickler\\|ObjectInputFilter\\|JsonSerializer' <app_source>/",
        "expected": "safe_load|SafeLoader|RestrictedUnpickler|ObjectInputFilter|JsonSerializer",
        "platform": "any"
      },
      {
        "command": "grep -rn 'yaml.load\\|pickle.load\\|marshal.load' <app_source>/ | grep -v 'safe_load\\|SafeLoader'",
        "expected": "No output",
        "platform": "any"
      },
      {
        "command": "grep -rn 'jdk.serialFilter\\|ObjectInputFilter\\|serialFilter' /etc/java/ /usr/lib/jvm/*/conf/ 2>/dev/null || java -XshowSettings 2>&1 | grep serialFilter",
        "expected": "serialFilter",
        "platform": "linux"
      },
      {
        "command": "grep -rn 'TypeNameHandling\\.None\\|TypeNameHandling\\.Auto\\|BinaryFormatter' <app_source>/ | grep -v None",
        "expected": "No output",
        "platform": "any"
      }
    ]
  },
