{
  "cme_id": "CME-204",
  "control_name": "IPsec / WireGuard (Encrypted Transport)",
  "description": "Encrypts all network traffic between hosts using IPsec or WireGuard, preventing eavesdropping, injection, and man-in-the-middle attacks on the wire.",
  "tactic": "Isolate",
  "category": "Network Isolation",
  "category_id": "network-isolation",
  "function_id": "network-access-control",
  "control_layer": "Network",
  "attenuation_type": "deterministic",
