{
  "cme_id": "CME-104",
  "control_name": "KASLR (Kernel Address Space Layout Randomization)",
  "description": "Randomizes the kernel base address at each boot, making kernel exploits harder by requiring address leaks to locate kernel functions and data structures.",
  "tactic": "Harden",
  "category": "Kernel Hardening",
  "category_id": "kernel-hardening",
  "function_id": "kernel-attack-surface",
  "control_layer": "OS/Kernel",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "AC",
      "from": "L",
      "to": "H",
      "rationale": "Kernel exploit must include info leak to locate kernel symbols"
    }
  ],
  "cwe_relationships": [
    "CWE-119",
    "CWE-269"
  ],
  "verification": {
    "method": "Verify KASLR is not disabled in boot parameters",
    "commands": [
      {
        "command": "cat /proc/cmdline | grep -v nokaslr && echo 'KASLR active'",
        "expected": "KASLR active",
        "platform": "linux"
      },
      {
        "command": "dmesg | grep 'KASLR'",
        "expected": "KASLR enabled",
        "platform": "linux"
      }
    ]
  },
  "confidence": "High",
  "platforms": [
    "RHEL 9",
    "RHEL 8",
    "Ubuntu 24.04",
    "SLES 15"
  ],
  "remediation": [
    {
      "id": "grub-kaslr-enable",
      "name": "Ensure KASLR is active by removing nokaslr from GRUB boot parameters",
      "platform": "linux",
      "precondition": "test -f /etc/default/grub",
      "steps": [
        {
          "description": "Remove nokaslr from GRUB_CMDLINE_LINUX in /etc/default/grub if present; KASLR is enabled by default on modern kernels so removing this flag restores the default",
          "command": "sed -i 's/ *nokaslr//g' /etc/default/grub",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "sed -i 's/\\(GRUB_CMDLINE_LINUX=\"[^\"]*\\)/\\1 nokaslr/' /etc/default/grub"
        },
        {
          "description": "Rebuild GRUB configuration to apply the updated boot parameters; requires a system reboot to take effect",
          "command": "grub2-mkconfig -o /boot/grub2/grub.cfg",
          "idempotent": true,
          "requires_restart": "system",
          "reversible": false
        }
      ],
      "verify": "cat /proc/cmdline | grep -v nokaslr && echo 'KASLR active'",
      "references": [
        {
          "source": "RHEL 9 Security Hardening — Kernel boot parameters",
          "url": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/security_hardening/overview-of-security-hardening-security-hardening"
        },
        {
          "source": "Kernel.org — KASLR documentation",
          "url": "https://www.kernel.org/doc/html/latest/admin-guide/kernel-parameters.html"
        }
      ]
    }
  ],
