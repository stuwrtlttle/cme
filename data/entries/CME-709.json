{
  "cme_id": "CME-709",
  "control_name": "systemd Service Sandboxing (PrivateDevices, PrivateTmp, ProtectSystem)",
  "description": "systemd unit directives that sandbox services: PrivateDevices removes device access, PrivateTmp isolates /tmp, ProtectSystem=strict makes / read-only, ProtectHome=true hides /home.",
  "tactic": "Isolate",
  "category": "Privilege Isolation",
  "category_id": "privilege-isolation",
  "function_id": "systemd-sandboxing",
  "control_layer": "OS/Kernel",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "S",
      "from": "C",
      "to": "U",
      "rationale": "Service isolated from host filesystem, devices, and user data"
    },
    {
      "metric": "C",
      "from": "H",
      "to": "L",
      "rationale": "Cannot access user home directories or arbitrary devices"
    },
    {
      "metric": "I",
      "from": "H",
      "to": "L",
      "rationale": "Cannot modify system files outside designated directories"
    }
  ],
  "cwe_relationships": [
    "CWE-269",
    "CWE-284",
    "CWE-367",
    "CWE-362"
  ],
  "verification": {
    "method": "Check systemd unit for sandbox directives",
    "commands": [
      {
        "command": "systemctl show <service> -p ProtectSystem,PrivateTmp,PrivateDevices,ProtectHome",
        "expected": "ProtectSystem=strict",
        "platform": "linux"
      }
    ]
  },
  "confidence": "High",
  "platforms": [
    "RHEL 9",
    "RHEL 8",
    "Ubuntu 24.04",
    "Fedora"
  ],
  "remediation": [
    {
      "id": "systemd-sandbox-drop-in",
      "name": "systemd drop-in with ProtectSystem, PrivateTmp, PrivateDevices, and ProtectHome",
      "platform": "linux",
      "precondition": "systemctl --version >/dev/null 2>&1",
      "steps": [
        {
          "description": "Create a systemd drop-in directory for the target service",
          "command": "mkdir -p /etc/systemd/system/<service>.service.d",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "rmdir /etc/systemd/system/<service>.service.d 2>/dev/null"
        },
        {
          "description": "Write a drop-in that enables filesystem isolation (ProtectSystem=strict makes / read-only), private /tmp, blocks device access, hides /home, prevents privilege escalation via NoNewPrivileges, and protects kernel tunables and module loading",
          "command": "printf '[Service]\\nProtectSystem=strict\\nPrivateTmp=true\\nPrivateDevices=true\\nProtectHome=true\\nNoNewPrivileges=true\\nProtectKernelTunables=true\\nProtectKernelModules=true\\n' > /etc/systemd/system/<service>.service.d/sandbox.conf",
          "idempotent": true,
          "requires_restart": "service",
          "reversible": true,
          "undo": "rm -f /etc/systemd/system/<service>.service.d/sandbox.conf"
        },
        {
          "description": "Reload systemd manager configuration to pick up the drop-in",
          "command": "systemctl daemon-reload",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": false
        },
        {
          "description": "Restart the service to apply sandbox directives",
          "command": "systemctl restart <service>",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": false
        }
      ],
      "verify": "systemctl show <service> -p ProtectSystem,PrivateTmp,PrivateDevices,ProtectHome",
      "references": [
        {
          "source": "systemd.exec(5) — Sandboxing directives",
          "url": "https://www.freedesktop.org/software/systemd/man/latest/systemd.exec.html#Sandboxing"
        },
        {
          "source": "RHEL 9 — Configuring systemd unit files",
          "url": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/using_systemd_unit_files_to_customize_and_optimize_your_system/assembly_working-with-systemd-unit-files_working-with-systemd"
        }
      ]
    }
  ],
