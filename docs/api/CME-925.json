{
  "cme_id": "CME-925",
  "control_name": "Windows Defender Application Control (WDAC)",
  "description": "Windows application allowlisting framework that enforces code integrity policies at the kernel level. WDAC prevents execution of unauthorized binaries, scripts, and drivers by validating digital signatures, file hashes, or file paths against a deployed policy. Operates in user-mode and kernel-mode, blocking unsigned or untrusted code before it executes. Supports multiple policy modes: Audit (logging only), Enforced (blocking), and Intelligent Security Graph (ISG) integration for cloud-based reputation checks. Successor to AppLocker with kernel-level enforcement.",
  "tactic": "Harden",
  "category": "Application Controls",
  "category_id": "application-controls",
  "function_id": "runtime-hardening",
  "effect_mode": "preventive",
  "evidence_state": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "AC",
      "from": "L",
      "to": "H",
      "rationale": "Unsigned/untrusted binaries blocked at kernel level; requires trusted publisher signature or hash"
    },
    {
      "metric": "I",
      "from": "H",
      "to": "L",
      "rationale": "Prevents execution of malicious code; attackers cannot run unsigned payloads"
    }
  ],
  "cwe_relationships": [
    "CWE-494",
    "CWE-829",
    "CWE-345"
  ],
  "verification": {
    "method": "Verify WDAC policy deployed and enforced",
    "commands": [
      {
        "command": "Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\\Microsoft\\Windows\\DeviceGuard | Select-Object -ExpandProperty CodeIntegrityPolicyEnforcementStatus",
        "expected": "1 (Enforced) or 2 (Audit)",
        "platform": "windows"
      },
      {
        "command": "Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\\Microsoft\\Windows\\DeviceGuard | Select-Object -ExpandProperty UsermodeCodeIntegrityPolicyEnforcementStatus",
        "expected": "1 (Enforced) or 2 (Audit)",
        "platform": "windows"
      },
      {
        "command": "Get-ChildItem -Path C:\\Windows\\System32\\CodeIntegrity\\CiPolicies\\Active\\*.cip",
        "expected": "At least one .cip policy file present",
        "platform": "windows"
      },
      {
        "command": "Get-WinEvent -FilterHashtable @{LogName='Microsoft-Windows-CodeIntegrity/Operational'; ID=3076} -MaxEvents 10",
        "expected": "Recent policy load events (ID 3076)",
        "platform": "windows"
      }
    ]
  },
  "references": [
    {
      "source": "Microsoft WDAC Documentation",
      "url": "https://learn.microsoft.com/en-us/windows/security/application-security/application-control/windows-defender-application-control/wdac"
    },
    {
      "source": "Windows Security Baselines",
      "url": "https://learn.microsoft.com/en-us/windows/security/operating-system-security/device-management/windows-security-configuration-framework/windows-security-baselines"
    }
  ],
  "platforms": [
    "Windows 10 1903+",
    "Windows 11",
    "Windows Server 2016+"
  ],
  "remediation": [
    {
      "id": "wdac-audit-mode",
      "name": "WDAC policy deployment in audit mode (logging only, no blocking)",
      "platform": "windows",
      "precondition": "Get-Command New-CIPolicy -ErrorAction SilentlyContinue",
      "steps": [
        {
          "description": "Create a baseline WDAC policy from the current system state using publisher-level trust with hash fallback. Audit mode logs violations without blocking execution, allowing safe evaluation before enforcement.",
          "command": "New-CIPolicy -Level Publisher -Fallback Hash -FilePath $env:TEMP\\CME925Policy.xml -UserPEs -Audit",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "Remove-Item $env:TEMP\\CME925Policy.xml -ErrorAction SilentlyContinue"
        },
        {
          "description": "Convert the XML policy to binary format for deployment",
          "command": "ConvertFrom-CIPolicy -XmlFilePath $env:TEMP\\CME925Policy.xml -BinaryFilePath $env:TEMP\\CME925Policy.cip",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "Remove-Item $env:TEMP\\CME925Policy.cip -ErrorAction SilentlyContinue"
        },
        {
          "description": "Deploy the binary policy to the Code Integrity active policies directory. A reboot is required for the policy to take full effect.",
          "command": "Copy-Item $env:TEMP\\CME925Policy.cip C:\\Windows\\System32\\CodeIntegrity\\CiPolicies\\Active\\ -Force",
          "idempotent": true,
          "requires_restart": "system",
          "reversible": true,
          "undo": "Remove-Item C:\\Windows\\System32\\CodeIntegrity\\CiPolicies\\Active\\CME925Policy.cip -ErrorAction SilentlyContinue"
        }
      ],
      "verify": "Get-CimInstance -ClassName Win32_DeviceGuard -Namespace root\\Microsoft\\Windows\\DeviceGuard | Select-Object -ExpandProperty UsermodeCodeIntegrityPolicyEnforcementStatus",
      "references": [
        {
          "source": "Microsoft — Deploy WDAC policies",
          "url": "https://learn.microsoft.com/en-us/windows/security/application-security/application-control/windows-defender-application-control/deployment/wdac-deployment-guide"
        },
        {
          "source": "Microsoft — Audit WDAC policies",
          "url": "https://learn.microsoft.com/en-us/windows/security/application-security/application-control/windows-defender-application-control/deployment/audit-wdac-policies"
        }
      ]
    }
  ],
  "scf_identifiers": [
    "STA-02",
    "STA-02.2"
  ],
  "relationships": [
    {
      "target_namespace": "CWE",
      "target_id": "CWE-494",
      "relationship_type": "mitigates",
      "method": "structural",
      "rationale": "Prevents download of code without integrity check by validating signatures/hashes",
      "evidence_state": "deterministic"
    },
    {
      "target_namespace": "CWE",
      "target_id": "CWE-829",
      "relationship_type": "mitigates",
      "method": "structural",
      "rationale": "Blocks inclusion of functionality from untrusted control sphere (unsigned binaries)",
      "evidence_state": "deterministic"
    },
    {
      "target_namespace": "CWE",
      "target_id": "CWE-345",
      "relationship_type": "mitigates",
      "method": "supportive",
      "rationale": "Enforces signature verification; insufficient data authentication blocked",
      "evidence_state": "deterministic"
    }
  ],
  "framework_bindings": [
