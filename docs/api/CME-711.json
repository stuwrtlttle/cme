{
  "cme_id": "CME-711",
  "control_name": "Admission Controller Policy Enforcement (OPA/Gatekeeper/Kyverno)",
  "description": "Policy-as-code enforcement at the Kubernetes admission gate. Admission controllers intercept API requests before persistence and reject workloads that violate security policies: no privileged containers, no host namespace sharing, required labels/annotations, image registry allowlists. Provides defense-in-depth on top of Pod Security Standards (CME-706) with custom policy granularity. OPA/Gatekeeper uses Rego policies via ConstraintTemplate CRDs; Kyverno uses Kubernetes-native ClusterPolicy resources. OpenShift SecurityContextConstraints serve as a built-in admission control mechanism.",
  "tactic": "Harden",
  "category": "Container Isolation",
  "category_id": "container-isolation",
  "function_id": "pod-security",
  "control_layer": "Application",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "AC",
      "from": "L",
      "to": "H",
      "rationale": "Attacker must bypass the policy engine to deploy a malicious or privileged workload; simply having API access is insufficient without a policy-compliant manifest — the attacker must find a policy gap, exempt namespace, or webhook bypass"
    }
  ],
  "cwe_relationships": [
    "CWE-269",
    "CWE-284",
    "CWE-250"
  ],
  "verification": {
    "method": "Verify admission controller is deployed and enforcing policies",
    "commands": [
      {
        "command": "kubectl get constraint --no-headers 2>/dev/null | wc -l",
        "expected": ">=1",
        "platform": "kubernetes"
      },
      {
        "command": "kubectl get clusterpolicy --no-headers 2>/dev/null | wc -l",
        "expected": ">=1",
        "platform": "kubernetes"
      },
      {
        "command": "oc get scc --no-headers 2>/dev/null | wc -l",
        "expected": ">=1",
        "platform": "kubernetes"
      },
      {
        "command": "kubectl get constraint -o jsonpath='{range .items[*]}{.spec.enforcementAction}{\"\\n\"}{end}' 2>/dev/null | grep -c -i 'deny'",
        "expected": ">=1",
        "platform": "kubernetes"
      },
      {
        "command": "kubectl run cme-test --image=busybox --restart=Never --dry-run=server --overrides='{\"spec\":{\"containers\":[{\"name\":\"test\",\"image\":\"busybox\",\"securityContext\":{\"privileged\":true}}]}}' 2>&1 | grep -c -i 'denied\\|forbidden\\|violated'",
        "expected": ">=1",
        "platform": "kubernetes"
      }
    ]
  },
  "confidence": "High",
  "platforms": [
    "Kubernetes 1.25+",
    "OpenShift 4.12+"
  ],
  "remediation": [
    {
      "id": "kyverno-block-privileged",
      "name": "Kyverno ClusterPolicy blocking privileged containers",
      "platform": "kubernetes",
      "precondition": "kubectl version --client >/dev/null 2>&1",
      "steps": [
        {
          "description": "Install Kyverno admission controller into the cluster",
          "command": "kubectl apply -f https://github.com/kyverno/kyverno/releases/download/<version>/install.yaml",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "kubectl delete -f https://github.com/kyverno/kyverno/releases/download/<version>/install.yaml"
        },
        {
          "description": "Wait for Kyverno pods to become ready before applying policies",
          "command": "kubectl wait --for=condition=Ready pods -l app.kubernetes.io/part-of=kyverno -n kyverno --timeout=120s",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": false
        },
        {
          "description": "Apply a ClusterPolicy that denies any pod requesting privileged securityContext",
          "command": "kubectl apply -f - <<'EOF'\napiVersion: kyverno.io/v1\nkind: ClusterPolicy\nmetadata:\n  name: disallow-privileged-containers\nspec:\n  validationFailureAction: Enforce\n  background: true\n  rules:\n    - name: deny-privileged\n      match:\n        any:\n          - resources:\n              kinds:\n                - Pod\n      validate:\n        message: \"Privileged containers are not allowed.\"\n        pattern:\n          spec:\n            containers:\n              - securityContext:\n                  privileged: \"!true\"\nEOF",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "kubectl delete clusterpolicy disallow-privileged-containers"
        }
      ],
      "verify": "kubectl run cme-test --image=busybox --restart=Never --dry-run=server --overrides='{\"spec\":{\"containers\":[{\"name\":\"test\",\"image\":\"busybox\",\"securityContext\":{\"privileged\":true}}]}}' 2>&1 | grep -c -i 'denied\\|forbidden\\|violated'",
      "references": [
        {
          "source": "Kyverno — Installation",
          "url": "https://kyverno.io/docs/installation/"
        },
        {
          "source": "Kyverno — Disallow Privileged Containers Policy",
          "url": "https://kyverno.io/policies/pod-security/baseline/disallow-privileged-containers/disallow-privileged-containers/"
        }
      ]
    },
    {
      "id": "openshift-scc",
      "name": "OpenShift SecurityContextConstraints enforcement (restricted-v2)",
      "platform": "kubernetes",
      "precondition": "oc version --client >/dev/null 2>&1",
      "steps": [
        {
          "description": "Verify that restricted-v2 SCC is present and is the default for authenticated users (ships by default on OpenShift 4.12+)",
          "command": "oc get scc restricted-v2 -o name",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": false
        },
        {
          "description": "Remove anyuid SCC grants from service accounts in the target namespace to enforce restricted-v2 as the effective SCC",
          "command": "oc adm policy remove-scc-from-user anyuid system:serviceaccount:<namespace>:<serviceaccount>",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "oc adm policy add-scc-to-user anyuid system:serviceaccount:<namespace>:<serviceaccount>"
        },
        {
          "description": "Remove privileged SCC grants from service accounts in the target namespace",
          "command": "oc adm policy remove-scc-from-user privileged system:serviceaccount:<namespace>:<serviceaccount>",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "oc adm policy add-scc-to-user privileged system:serviceaccount:<namespace>:<serviceaccount>"
        }
      ],
      "verify": "oc get scc --no-headers && kubectl run cme-test --image=busybox --restart=Never --dry-run=server --overrides='{\"spec\":{\"containers\":[{\"name\":\"test\",\"image\":\"busybox\",\"securityContext\":{\"privileged\":true}}]}}' 2>&1 | grep -c -i 'denied\\|forbidden\\|violated'",
      "references": [
        {
          "source": "OpenShift — Managing Security Context Constraints",
          "url": "https://docs.openshift.com/container-platform/4.14/authentication/managing-security-context-constraints.html"
        },
        {
          "source": "OpenShift — Default SCCs",
          "url": "https://docs.openshift.com/container-platform/4.14/authentication/managing-security-context-constraints.html#default-sccs_configuring-internal-oauth"
        }
      ]
    }
  ],
