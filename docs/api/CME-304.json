{
  "cme_id": "CME-304",
  "control_name": "AppArmor (Enforcing Profile)",
  "description": "Path-based mandatory access control that restricts per-application file, network, and capability access. Each application runs under a profile defining allowed operations.",
  "tactic": "Harden",
  "category": "Mandatory Access Control",
  "category_id": "mandatory-access-control",
  "function_id": "apparmor",
  "control_layer": "OS/Kernel",
  "attenuation_type": "deterministic",
  "cvss_vector_impacts": [
    {
      "metric": "S",
      "from": "C",
      "to": "U",
      "rationale": "Process confined to profile-defined resources"
    },
    {
      "metric": "C",
      "from": "H",
      "to": "L",
      "rationale": "Cannot read files outside profile allowlist"
    }
  ],
  "cwe_relationships": [
    "CWE-269",
    "CWE-284"
  ],
  "verification": {
    "method": "Check AppArmor status and profile enforcement",
    "commands": [
      {
        "command": "aa-status --enforced 2>/dev/null | head -5",
        "expected": "profiles are in enforce mode",
        "platform": "debian"
      }
    ]
  },
  "confidence": "High",
  "platforms": [
    "Ubuntu 24.04",
    "SLES 15",
    "Debian 12"
  ],
  "remediation": [
    {
      "id": "apparmor-enforce",
      "name": "AppArmor profile enforcement via aa-enforce",
      "platform": "debian",
      "precondition": "command -v aa-status >/dev/null 2>&1",
      "steps": [
        {
          "description": "Install AppArmor and management utilities if not already present",
          "command": "apt-get install -y apparmor apparmor-utils",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "apt-get remove -y apparmor-utils"
        },
        {
          "description": "Set all loaded AppArmor profiles to enforce mode, blocking any access not explicitly permitted by the profile",
          "command": "aa-enforce /etc/apparmor.d/*",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "aa-complain /etc/apparmor.d/*"
        },
        {
          "description": "Reload AppArmor to ensure all profiles are active",
          "command": "systemctl reload apparmor",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": false
        }
      ],
      "verify": "aa-status --enforced 2>/dev/null | head -5",
      "references": [
        {
          "source": "Ubuntu — AppArmor",
          "url": "https://ubuntu.com/server/docs/apparmor"
        },
        {
          "source": "Debian Wiki — AppArmor/HowToUse",
          "url": "https://wiki.debian.org/AppArmor/HowToUse"
        }
      ]
    }
  ],
