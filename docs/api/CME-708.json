  ],
  "verification": {
    "method": "Audit sudoers for overly permissive rules",
    "commands": [
      {
        "command": "grep -r 'ALL=(ALL)' /etc/sudoers /etc/sudoers.d/ 2>/dev/null | grep -v NOPASSWD",
        "expected": "Minimal matches",
        "platform": "linux"
      }
    ]
  },
  "confidence": "Medium",
  "platforms": [
    "RHEL 9",
    "RHEL 8",
    "Ubuntu 24.04"
  ],
  "remediation": [
    {
      "id": "sudoers-least-privilege",
      "name": "sudoers.d drop-in with command allowlists and hardening defaults",
      "platform": "linux",
      "precondition": "command -v visudo >/dev/null 2>&1",
      "steps": [
        {
          "description": "Set secure defaults in a sudoers.d drop-in: require TTY, use pseudo-terminal for session logging, log all sudo invocations, set a 5-minute credential timeout",
          "command": "printf 'Defaults requiretty\\nDefaults use_pty\\nDefaults logfile=/var/log/sudo.log\\nDefaults timestamp_timeout=5\\n' > /etc/sudoers.d/00-cme-708-defaults && visudo -cf /etc/sudoers.d/00-cme-708-defaults",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "rm -f /etc/sudoers.d/00-cme-708-defaults"
        },
        {
          "description": "Create a command allowlist for the admin group — replace ALL=(ALL) ALL with specific allowed commands (customize the command list for your environment)",
          "command": "printf '%%<admin_group> ALL=(root) /usr/bin/systemctl restart *, /usr/bin/journalctl, /usr/sbin/reboot, /usr/bin/dnf update\\n' > /etc/sudoers.d/10-cme-708-admins && visudo -cf /etc/sudoers.d/10-cme-708-admins",
          "idempotent": true,
          "requires_restart": "none",
          "reversible": true,
          "undo": "rm -f /etc/sudoers.d/10-cme-708-admins"
        },
        {
          "description": "Remove or comment out overly permissive ALL=(ALL) ALL rules from main sudoers (backs up original first)",
          "command": "cp /etc/sudoers /etc/sudoers.bak.cme-708 && sed -i 's/^\\(%[a-z].*ALL=(ALL)\\s*ALL\\)/#\\1  # disabled by CME-708/' /etc/sudoers && visudo -cf /etc/sudoers",
          "idempotent": false,
          "requires_restart": "none",
          "reversible": true,
          "undo": "cp /etc/sudoers.bak.cme-708 /etc/sudoers"
        }
      ],
      "verify": "grep -r 'ALL=(ALL)' /etc/sudoers /etc/sudoers.d/ 2>/dev/null | grep -v '^#' | grep -cv NOPASSWD",
      "references": [
        {
          "source": "RHEL 9 — Configuring sudo access",
          "url": "https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/9/html/configuring_basic_system_settings/managing-sudo-access_configuring-basic-system-settings"
        },
        {
          "source": "sudoers manual — Command specifications",
          "url": "https://www.sudo.ws/docs/man/sudoers.man/#Command_specifications"
        }
      ]
    }
  ],
